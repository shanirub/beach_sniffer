[Unit]
Description=BeachSniffer Packet Visualizer
After=network.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/beachsniffer
ExecStart=/usr/bin/python3 -m beachsniffer.main --iface wlan0 --fps 15
Restart=always
RestartSec=5
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1

[Install]
WantedBy=multi-user.target